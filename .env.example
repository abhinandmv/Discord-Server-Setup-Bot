# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID (Developer Mode -> right-click server -> Copy Server ID).
# When set, slash commands are synced to this guild only and show up instantly.
# Leave empty to sync globally (can take up to an hour to appear).
TEST_GUILD_ID=

# Optional: where the bot stores the IDs of everything it creates.
DATABASE_PATH=data/bot.db
